{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\"}[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "Requests per second (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_sum{namespace=~\"$namespace\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\"}[5m])) * 1000",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "Average HTTP latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\",namespace=~\"$namespace\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\"}[5m])) * 100",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "HTTP error rate (5xx)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "avg by (application) (process_cpu_usage{namespace=~\"$namespace\"})",
          "legendFormat": "{{application}} CPU",
          "refId": "A"
        }
      ],
      "title": "CPU usage (process)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\",namespace=~\"$namespace\"})",
          "legendFormat": "{{application}} heap",
          "refId": "A"
        }
      ],
      "title": "JVM heap memory usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "locust_requests_current_rps",
          "legendFormat": "Locust RPS",
          "refId": "A"
        },
        {
          "expr": "locust_requests_num_failures",
          "legendFormat": "Locust failures",
          "refId": "B"
        }
      ],
      "title": "Locust load test metrics",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
