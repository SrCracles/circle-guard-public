pipeline {
    agent any
    environment {
        DOCKER_USER = "${env.CG_DOCKER_USER ?: 'srcracles'}"
        DOCKERHUB_CREDENTIALS_ID = "${env.CG_DOCKERHUB_CREDENTIALS_ID ?: 'dockerhub-credentials'}"
        SERVICE_NAME = 'circleguard-form-service'
        SERVICE_PORT = '8086'
        DOCKER_IMAGE = "${DOCKER_USER}/${SERVICE_NAME}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Test') {
            steps {
                bat '.\\gradlew.bat :services:%SERVICE_NAME%:test'
            }
            post {
                always {
                    junit testResults: "**/build/test-results/test/*.xml", allowEmptyResults: true
                }
            }
        }
        stage('Build JAR') {
            steps {
                bat '.\\gradlew.bat :services:%SERVICE_NAME%:bootJar'
            }
        }
        stage('Build Docker Image') {
            steps {
                bat "docker build -t %DOCKER_IMAGE%:dev services/%SERVICE_NAME%/"
            }
        }
        stage('Push Docker Image (dev tag)') {
            steps {
                withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
                    bat "docker push %DOCKER_IMAGE%:dev"
                }
            }
        }
    }
    post {
        success {
            echo "Pipeline succeeded for ${SERVICE_NAME}"
            bat "docker rmi %DOCKER_IMAGE%:dev || exit 0"
        }
        failure {
            echo "Pipeline failed for ${SERVICE_NAME}"
        }
    }
}
