pipeline {
    agent any
    environment {
        DOCKER_USER = "${env.CG_DOCKER_USER ?: 'srcracles'}"
        DOCKERHUB_CREDENTIALS_ID = "${env.CG_DOCKERHUB_CREDENTIALS_ID ?: 'dockerhub-credentials'}"
        TRIVY_SEVERITY_FAIL = "${env.CG_TRIVY_SEVERITY_FAIL ?: 'CRITICAL'}"
        SERVICE_NAME = 'circleguard-form-service'
        SERVICE_PORT = '8086'
        DOCKER_IMAGE = "${DOCKER_USER}/${SERVICE_NAME}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        // TEMP (HU-30/32 ELK): cambiar expression { false } por { true } para restaurar quality gates
        stage('Test') {
            when { expression { false } }
            steps {
                bat '.\\gradlew.bat --no-daemon :services:%SERVICE_NAME%:test jacocoTestCoverageVerification'
            }
            post {
                always {
                    junit testResults: "**/build/test-results/test/*.xml", allowEmptyResults: true
                    recordCoverage tools: [[parser: 'JACOCO', pattern: '**/build/reports/jacoco/test/jacocoTestReport.xml']], sourceDirectories: [[path: "services/${SERVICE_NAME}/src/main/java"]]
                }
            }
        }
        stage('SonarQube Analysis') {
            when { expression { false } }
            steps {
                bat "docker run --rm -v \"%WORKSPACE%\\services\\%SERVICE_NAME%\":/usr/src sonarsource/sonar-scanner-cli -Dsonar.projectBaseDir=/usr/src -Dsonar.host.url=http://host.docker.internal:9000 -Dsonar.qualitygate.wait=true -Dsonar.login=admin -Dsonar.password=admin"
            }
        }
        stage('Build JAR') {
            steps {
                bat '.\\gradlew.bat --no-daemon :services:%SERVICE_NAME%:bootJar'
            }
        }
        stage('Build Docker Image') {
            steps {
                bat "docker build -t %DOCKER_IMAGE%:dev services/%SERVICE_NAME%/"
            }
        }
        stage('Trivy Scan') {
            when { expression { false } }
            steps {
                // Reporte JSON completo (HIGH + CRITICAL) - se archiva como artefacto
                bat(script: "trivy image --format json --output trivy-report.json --severity HIGH,CRITICAL --ignorefile services\\%SERVICE_NAME%\\.trivyignore --ignore-unfixed %DOCKER_IMAGE%:dev", returnStatus: true)
                // Reporte tabla - severidad HIGH (informativo, no bloquea el pipeline)
                bat(script: "trivy image --format table --severity HIGH --exit-code 0 --ignorefile services\\%SERVICE_NAME%\\.trivyignore --ignore-unfixed %DOCKER_IMAGE%:dev", returnStatus: true)
                // Falla el pipeline si se detectan vulnerabilidades de severidad CRITICAL (configurable via CG_TRIVY_SEVERITY_FAIL)
                bat "trivy image --format table --severity %TRIVY_SEVERITY_FAIL% --exit-code 1 --ignorefile services\\%SERVICE_NAME%\\.trivyignore --ignore-unfixed %DOCKER_IMAGE%:dev"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                }
            }
        }
        stage('Push Docker Image (dev tag)') {
            steps {
                withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
                    bat "docker push %DOCKER_IMAGE%:dev"
                }
            }
        }
    }
    post {
        success {
            script {
                def notify = load 'jenkins/lib/pipeline-notifications.groovy'
                notify.sendRecoveryNotification(pipelineName: "${SERVICE_NAME} (dev)")
            }
            echo "Pipeline succeeded for ${SERVICE_NAME}"
            bat "docker rmi %DOCKER_IMAGE%:dev || exit 0"
        }
        failure {
            script {
                def notify = load 'jenkins/lib/pipeline-notifications.groovy'
                notify.sendFailureNotification(pipelineName: "${SERVICE_NAME} (dev)")
            }
            echo "Pipeline failed for ${SERVICE_NAME}"
        }
    }
}
