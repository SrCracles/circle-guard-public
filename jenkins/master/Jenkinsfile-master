pipeline {
    agent any
    environment {
        DOCKER_USER = 'srcracles'
        VERSION = "${env.BUILD_NUMBER}"
        RELEASE_NOTES_FILE = "RELEASE_NOTES_v${env.BUILD_NUMBER}.md"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Teardown Master Environment') {
            steps {
                echo 'Stopping existing deployments in master namespace...'
                bat 'kubectl delete deployment --all -n master --ignore-not-found=true'
                bat 'kubectl delete svc --all -n master --ignore-not-found=true'
                bat 'ping 127.0.0.1 -n 4 > nul'
            }
        }
        stage('Pull stage images from DockerHub') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "docker pull ${DOCKER_USER}/${svc}:stage"
                    }
                }
            }
        }
        stage('Deploy to Kind Master') {
            steps {
                echo 'Deploying full architecture to master namespace...'
                bat 'kubectl apply -f k8s/master/ -n master'
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "kubectl set image deployment/${svc} ${svc}=${DOCKER_USER}/${svc}:stage -n master"
                    }
                }
                bat 'kubectl rollout status deployment -n master --timeout=300s'
            }
        }
        stage('Generate Release Notes') {
            steps {
                script {
                    def lastTag = bat(script: 'git describe --tags --abbrev=0 2>nul || echo "v0"', returnStdout: true).trim()
                    if (lastTag == "v0") {
                        lastTag = ""
                    }

                    def changelog = bat(script: """
                        @echo off
                        echo # Release Notes v${VERSION}
                        echo.
                        echo **Release Date:** %DATE% %TIME%
                        echo.
                        echo **Docker Images:**
                        echo - srcracles/circleguard-auth-service:stage
                        echo - srcracles/circleguard-identity-service:stage
                        echo - srcracles/circleguard-form-service:stage
                        echo - srcracles/circleguard-promotion-service:stage
                        echo - srcracles/circleguard-notification-service:stage
                        echo - srcracles/circleguard-gateway-service:stage
                        echo.
                        echo ## Changes
                        echo.
                    """, returnStdout: true).trim()

                    def features = bat(script: "git log ${lastTag}..HEAD --oneline --grep=\"^feat\\|^feature\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def fixes = bat(script: "git log ${lastTag}..HEAD --oneline --grep=\"^fix\\|^bugfix\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def docs = bat(script: "git log ${lastTag}..HEAD --oneline --grep=\"^docs\\|^doc\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def tests = bat(script: "git log ${lastTag}..HEAD --oneline --grep=\"^test\\|^tests\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def ci = bat(script: "git log ${lastTag}..HEAD --oneline --grep=\"^ci\\|^build\\|^pipeline\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def others = bat(script: "git log ${lastTag}..HEAD --oneline 2>nul || echo \"\"", returnStdout: true).trim()

                    writeFile file: "${RELEASE_NOTES_FILE}", text: """${changelog}

### Features
${features ?: "- No new features in this release."}

### Bug Fixes
${fixes ?: "- No bug fixes in this release."}

### Documentation
${docs ?: "- No documentation changes in this release."}

### Tests
${tests ?: "- No test changes in this release."}

### CI/CD & Build
${ci ?: "- No CI/CD changes in this release."}

### Other Changes
${others ?: "- No other changes in this release."}

---

**Deployment Notes:**
- Deployed to Kubernetes master namespace
- All services use Docker image tag: `stage`
- Verify deployment: `kubectl get pods -n master`

**Verification Checklist:**
- [ ] All pods running in master namespace
- [ ] Services accessible via ClusterIP
- [ ] Health endpoints responding
"""
                }
                archiveArtifacts artifacts: "${RELEASE_NOTES_FILE}", allowEmptyArchive: false
            }
        }
        stage('Git Tag Release') {
            steps {
                bat "git tag -a v%VERSION% -m \"Release v%VERSION%\""
                bat "git push origin v%VERSION%"
            }
        }
    }
    post {
        success {
            echo "Release v${VERSION} deployed to master namespace from stage images"
            echo "Release Notes: ${RELEASE_NOTES_FILE}"
        }
        failure {
            echo "Master pipeline failed. Review logs and re-run."
        }
    }
}
