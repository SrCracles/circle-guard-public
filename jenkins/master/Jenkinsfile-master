pipeline {
    agent any
    environment {
        DOCKER_USER = 'srcracles'
        VERSION = "${env.BUILD_NUMBER}"
        RELEASE_NOTES_FILE = "RELEASE_NOTES_v${env.BUILD_NUMBER}.md"
        GITHUB_OWNER = 'SrCracles'
        GITHUB_REPO = 'circle-guard-public'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Teardown Master Environment') {
            steps {
                echo 'Stopping existing deployments in master namespace...'
                bat 'kubectl delete deployment --all -n master --ignore-not-found=true'
                bat 'kubectl delete svc --all -n master --ignore-not-found=true'
                bat 'ping 127.0.0.1 -n 4 > nul'
            }
        }
        stage('Pull stage images from DockerHub') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "docker pull ${DOCKER_USER}/${svc}:stage"
                    }
                }
            }
        }
        stage('Deploy to Kind Master') {
            steps {
                echo 'Deploying full architecture to master namespace...'
                bat 'kubectl apply -k k8s/master/'
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "kubectl set image deployment/${svc} ${svc}=${DOCKER_USER}/${svc}:stage -n master"
                    }
                }
                bat 'kubectl rollout status deployment -n master --timeout=300s'
            }
        }
        stage('Generate Release Notes') {
            steps {
                script {
                    def lastTag = ""
                    def hasPreviousTag = bat(script: 'git describe --tags --abbrev=0 >nul 2>nul', returnStatus: true) == 0
                    if (hasPreviousTag) {
                        lastTag = bat(script: 'git describe --tags --abbrev=0', returnStdout: true).trim()
                    }

                    def releaseRange = lastTag ? "${lastTag}..HEAD" : ""
                    def releaseRangePrefix = releaseRange ? "${releaseRange} " : ""

                    def features = bat(script: "git log ${releaseRangePrefix}--oneline --grep=\"^feat\\|^feature\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def fixes = bat(script: "git log ${releaseRangePrefix}--oneline --grep=\"^fix\\|^bugfix\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def docs = bat(script: "git log ${releaseRangePrefix}--oneline --grep=\"^docs\\|^doc\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def tests = bat(script: "git log ${releaseRangePrefix}--oneline --grep=\"^test\\|^tests\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def ci = bat(script: "git log ${releaseRangePrefix}--oneline --grep=\"^ci\\|^build\\|^pipeline\" 2>nul || echo \"\"", returnStdout: true).trim()
                    def others = bat(script: "git log ${releaseRangePrefix}--oneline 2>nul || echo \"\"", returnStdout: true).trim()

                    def releaseBody = """## Changes

### Features
${features ?: "- No new features in this release."}

### Bug Fixes
${fixes ?: "- No bug fixes in this release."}

### Documentation
${docs ?: "- No documentation changes in this release."}

### Tests
${tests ?: "- No test changes in this release."}

### CI/CD & Build
${ci ?: "- No CI/CD changes in this release."}

### Other Changes
${others ?: "- No other changes in this release."}

---

**Docker Images:**
- srcracles/circleguard-auth-service:stage
- srcracles/circleguard-identity-service:stage
- srcracles/circleguard-form-service:stage
- srcracles/circleguard-promotion-service:stage
- srcracles/circleguard-notification-service:stage
- srcracles/circleguard-gateway-service:stage

**Deployment Notes:**
- Deployed to Kubernetes master namespace
- All services use Docker image tag: `stage`
- Verify deployment: `kubectl get pods -n master`
"""

                    writeFile file: "${RELEASE_NOTES_FILE}", text: releaseBody
                    env.RELEASE_BODY = releaseBody
                }
                archiveArtifacts artifacts: "${RELEASE_NOTES_FILE}", allowEmptyArchive: false
            }
        }
        stage('Git Tag Release') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    bat 'git config user.name "Jenkins CI"'
                    bat 'git config user.email "jenkins@users.noreply.github.com"'
                    bat "git tag -a v%VERSION% -m \"Release v%VERSION%\""
                    bat "git push https://x-access-token:%GITHUB_TOKEN%@github.com/%GITHUB_OWNER%/%GITHUB_REPO%.git refs/tags/v%VERSION%"
                }
            }
        }
        stage('Publish GitHub Release') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    script {
                        def jsonBody = """
                        {
                            "tag_name": "v${VERSION}",
                            "name": "Release v${VERSION}",
                            "body": "${env.RELEASE_BODY.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')}",
                            "draft": false,
                            "prerelease": false
                        }
                        """

                        writeFile file: 'github-release-payload.json', text: jsonBody

                        bat """
                            curl -L -X POST "https://api.github.com/repos/%GITHUB_OWNER%/%GITHUB_REPO%/releases" ^
                            -H "Accept: application/vnd.github+json" ^
                            -H "Authorization: Bearer %GITHUB_TOKEN%" ^
                            -H "X-GitHub-Api-Version: 2022-11-28" ^
                            -d @github-release-payload.json
                        """
                    }
                }
            }
        }
    }
    post {
        success {
            echo "Release v${VERSION} deployed to master namespace and published to GitHub"
        }
        failure {
            echo "Master pipeline failed. Review logs and re-run."
        }
    }
}