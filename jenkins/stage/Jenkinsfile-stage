pipeline {
    agent any
    environment {
        DOCKER_USER = "${env.CG_DOCKER_USER ?: 'srcracles'}"
        DOCKERHUB_CREDENTIALS_ID = "${env.CG_DOCKERHUB_CREDENTIALS_ID ?: 'dockerhub-credentials'}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def propsFileContent = readFile('jenkins/jenkins.properties')
                    def lines = propsFileContent.split('\r?\n')
                    for (line in lines) {
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            def key = parts[0].trim()
                            def val = parts[1].trim()
                            if (key == 'NEWMAN_COLLECTION') {
                                env.NEWMAN_COLLECTION = val
                            } else if (key == 'NEWMAN_ENVIRONMENT') {
                                env.NEWMAN_ENVIRONMENT = val
                            } else if (key == 'LOCUST_PERF_FILE') {
                                env.LOCUST_PERF_FILE = val
                            } else if (key == 'LOCUST_STRESS_FILE') {
                                env.LOCUST_STRESS_FILE = val
                            }
                        }
                    }
                }
            }
        }
        stage('Pull dev images from DockerHub') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service',
                        'circleguard-file-service',
                        'circleguard-dashboard-service'
                    ]
                    for (svc in services) {
                        bat "docker pull ${DOCKER_USER}/${svc}:dev"
                    }
                }
            }
        }
        stage('Deploy to Stage Environment') {
            steps {
                echo 'Ensuring stage namespace exists...'
                bat 'kubectl create namespace stage --dry-run=client -o yaml | kubectl apply -f -'
                echo 'Configuring dynamic Kustomize images...'
                script {
                    def kustomization = readFile('k8s/stage/kustomization.yaml')
                    kustomization = kustomization.replaceAll('newName: srcracles/', "newName: ${env.DOCKER_USER}/")
                    kustomization = kustomization.replaceAll('newTag: stage', 'newTag: dev')
                    writeFile(file: 'k8s/stage/kustomization.yaml', text: kustomization)
                }
                echo 'Applying stage manifests...'
                bat 'kubectl apply -k k8s/stage/'
                echo 'Waiting for services to become ready one by one...'
                script {
                    def services = ['auth', 'identity', 'form', 'gateway', 'notification', 'file', 'promotion', 'dashboard']
                    for (svc in services) {
                        echo "Waiting for circleguard-${svc}-service..."
                        bat "kubectl rollout status deployment/circleguard-${svc}-service -n stage --timeout=300s"
                    }
                }
            }
        }
        stage('E2E Tests - Newman') {
            steps {
                echo 'Running Newman E2E tests inside Kubernetes cluster...'
                bat 'kubectl run newman-e2e --restart=Never --image=postman/newman:latest -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/newman-e2e -n stage --timeout=60s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%NEWMAN_COLLECTION%" newman-e2e:/tmp/collection.json -n stage -c newman-e2e'
                bat 'kubectl cp "%NEWMAN_ENVIRONMENT%" newman-e2e:/tmp/environment.json -n stage -c newman-e2e'
                bat 'kubectl exec newman-e2e -n stage -c newman-e2e -- newman run /tmp/collection.json -e /tmp/environment.json --delay-request 500 --reporters cli,junit --reporter-junit-export /tmp/newman-report.xml'
                bat 'kubectl cp newman-e2e:/tmp/newman-report.xml newman-report.xml -n stage -c newman-e2e'
                bat 'kubectl delete pod newman-e2e -n stage --ignore-not-found=true'
            }
            post {
                always {
                    junit testResults: 'newman-report.xml', allowEmptyResults: true
                }
            }
        }
        stage('Performance Test - Locust') {
            steps {
                echo 'Running Locust performance test inside Kubernetes cluster...'
                bat 'kubectl run locust-perf --restart=Never --image=locustio/locust:2.29.0 -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/locust-perf -n stage --timeout=60s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%LOCUST_PERF_FILE%" locust-perf:/tmp/locustfile.py -n stage -c locust-perf'
                bat 'kubectl exec locust-perf -n stage -c locust-perf -- locust -f /tmp/locustfile.py --host http://circleguard-auth-service:8180 -u 20 -r 2 --run-time 60s --headless --csv=/tmp/locust-performance'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_stats.csv locust-performance_stats.csv -n stage -c locust-perf || echo "No perf stats"'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_failures.csv locust-performance_failures.csv -n stage -c locust-perf || echo "No perf failures"'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_exceptions.csv locust-performance_exceptions.csv -n stage -c locust-perf || echo "No perf exceptions"'
                bat 'kubectl delete pod locust-perf -n stage --ignore-not-found=true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-performance_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Stress Test - Locust') {
            steps {
                echo 'Running Locust stress test inside Kubernetes cluster...'
                bat 'kubectl run locust-stress --restart=Never --image=locustio/locust:2.29.0 -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/locust-stress -n stage --timeout=60s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%LOCUST_STRESS_FILE%" locust-stress:/tmp/locustfile.py -n stage -c locust-stress'
                bat 'kubectl exec locust-stress -n stage -c locust-stress -- locust -f /tmp/locustfile.py --host http://circleguard-auth-service:8180 -u 50 -r 3 --run-time 60s --headless --csv=/tmp/locust-stress'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_stats.csv locust-stress_stats.csv -n stage -c locust-stress || echo "No stress stats"'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_failures.csv locust-stress_failures.csv -n stage -c locust-stress || echo "No stress failures"'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_exceptions.csv locust-stress_exceptions.csv -n stage -c locust-stress || echo "No stress exceptions"'
                bat 'kubectl delete pod locust-stress -n stage --ignore-not-found=true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-stress_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Generate Performance Report') {
            steps {
                script {
                    def perfStats = ""
                    def stressStats = ""
                    
                    if (fileExists('locust-performance_stats.csv')) {
                        perfStats = readFile('locust-performance_stats.csv')
                    }
                    if (fileExists('locust-stress_stats.csv')) {
                        stressStats = readFile('locust-stress_stats.csv')
                    }
                    
                    writeFile file: 'PERFORMANCE_REPORT.md', text: """# Performance Test Report

## Performance Test (Normal Load)
- Users: 20
- Ramp-up: 2 users/sec
- Duration: 60 seconds

```csv
${perfStats}
```

## Stress Test (High Load)
- Users: 50
- Ramp-up: 3 users/sec
- Duration: 60 seconds

```csv
${stressStats}
```

## Artifacts
- locust-performance_stats.csv
- locust-performance_failures.csv
- locust-performance_exceptions.csv
- locust-stress_stats.csv
- locust-stress_failures.csv
- locust-stress_exceptions.csv
"""
                }
                archiveArtifacts artifacts: 'PERFORMANCE_REPORT.md', allowEmptyArchive: true
            }
        }
        stage('Promote dev to stage tag') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service',
                        'circleguard-file-service',
                        'circleguard-dashboard-service'
                    ]
                    for (svc in services) {
                        bat "docker tag ${DOCKER_USER}/${svc}:dev ${DOCKER_USER}/${svc}:stage"
                        withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
                            bat "docker push ${DOCKER_USER}/${svc}:stage"
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            echo 'Stage pipeline failed. Resources left running for debugging.'
            echo 'Run manually to clean up: kubectl delete deployment,service,configmap,secret --all -n stage'
        }
        success {
            echo 'Stage pipeline succeeded. Cleaning up stage resources and local images...'
            bat 'kubectl delete deployment --all -n stage --ignore-not-found=true'
            bat 'kubectl delete service --all -n stage --ignore-not-found=true'
            bat 'kubectl delete configmap --all -n stage --ignore-not-found=true'
            bat 'kubectl delete secret --all -n stage --ignore-not-found=true'
            bat 'kubectl delete pod --all -n stage --force --grace-period=0 --ignore-not-found=true'
            script {
                def services = [
                    'circleguard-auth-service',
                    'circleguard-identity-service',
                    'circleguard-form-service',
                    'circleguard-promotion-service',
                    'circleguard-notification-service',
                    'circleguard-gateway-service',
                    'circleguard-file-service',
                    'circleguard-dashboard-service'
                ]
                for (svc in services) {
                    bat "docker rmi ${DOCKER_USER}/${svc}:dev 2>nul || exit 0"
                    bat "docker rmi ${DOCKER_USER}/${svc}:stage 2>nul || exit 0"
                }
            }
        }
    }
}
