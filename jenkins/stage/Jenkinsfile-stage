pipeline {
    agent any
    environment {
        DOCKER_USER = 'srcracles'
        NEWMAN_COLLECTION = 'tests/postman/circle-guard-e2e-collection.json'
        NEWMAN_ENVIRONMENT = 'tests/postman/circle-guard-environment.json'
        LOCUST_FILE = 'tests/locustfile.py'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Pull dev images from DockerHub') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "docker pull ${DOCKER_USER}/${svc}:dev"
                    }
                }
            }
        }
        stage('Deploy to Stage Environment') {
            steps {
                echo 'Deploying services to Kind stage namespace...'
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "kubectl set image deployment/${svc} ${svc}=${DOCKER_USER}/${svc}:dev -n stage"
                    }
                }
                bat 'kubectl rollout status deployment -n stage --timeout=300s'
                bat 'start /B kubectl port-forward svc/circleguard-auth-service 8180:8180 -n stage'
                bat 'start /B kubectl port-forward svc/circleguard-form-service 8086:8086 -n stage'
                bat 'start /B kubectl port-forward svc/circleguard-gateway-service 8087:8087 -n stage'
                bat 'start /B kubectl port-forward svc/circleguard-promotion-service 8088:8088 -n stage'
                bat 'ping 127.0.0.1 -n 6 > nul'
            }
        }
        stage('E2E Tests - Newman') {
            steps {
                bat "newman run %NEWMAN_COLLECTION% -e %NEWMAN_ENVIRONMENT% --delay-request 500 --reporters cli,junit,html --reporter-junit-export newman-report.xml --reporter-html-export newman-report.html"
            }
            post {
                always {
                    junit 'newman-report.xml'
                    publishHTML([allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: '.', reportFiles: 'newman-report.html', reportName: 'Newman E2E Report'])
                }
            }
        }
        stage('Performance Test - Locust') {
            steps {
                echo 'Running performance test (normal load, 20 users, 1 min)...'
                bat "locust -f %LOCUST_FILE% --host http://localhost:8180 -u 20 -r 2 --run-time 60s --headless --csv=locust-performance"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-performance_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Stress Test - Locust') {
            steps {
                echo 'Running stress test (high load, 50 users, 1 min)...'
                bat "locust -f %LOCUST_FILE% --host http://localhost:8180 -u 50 -r 5 --run-time 60s --headless --csv=locust-stress"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-stress_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Generate Performance Report') {
            steps {
                script {
                    def perfStats = ""
                    def stressStats = ""
                    
                    if (fileExists('locust-performance_stats.csv')) {
                        perfStats = readFile('locust-performance_stats.csv')
                    }
                    if (fileExists('locust-stress_stats.csv')) {
                        stressStats = readFile('locust-stress_stats.csv')
                    }
                    
                    writeFile file: 'PERFORMANCE_REPORT.md', text: """# Performance Test Report

## Performance Test (Normal Load)
- Users: 20
- Ramp-up: 2 users/sec
- Duration: 60 seconds

```csv
${perfStats}
```

## Stress Test (High Load)
- Users: 50
- Ramp-up: 5 users/sec
- Duration: 60 seconds

```csv
${stressStats}
```

## Artifacts
- locust-performance_stats.csv
- locust-performance_failures.csv
- locust-performance_exceptions.csv
- locust-stress_stats.csv
- locust-stress_failures.csv
- locust-stress_exceptions.csv
"""
                }
                archiveArtifacts artifacts: 'PERFORMANCE_REPORT.md', allowEmptyArchive: true
            }
        }
        stage('Promote dev to stage tag') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service'
                    ]
                    for (svc in services) {
                        bat "docker tag ${DOCKER_USER}/${svc}:dev ${DOCKER_USER}/${svc}:stage"
                        withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                            bat "docker push ${DOCKER_USER}/${svc}:stage"
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            echo 'Cleaning up port-forwards...'
            bat 'taskkill /F /IM kubectl.exe 2>nul || exit 0'
        }
        failure {
            echo 'Stage pipeline failed. Images were NOT promoted to stage tag.'
        }
        success {
            echo 'Stage pipeline succeeded. All images promoted from dev to stage tag.'
        }
    }
}
