pipeline {
    agent any
    environment {
        DOCKER_USER = "${env.CG_DOCKER_USER ?: 'srcracles'}"
        DOCKERHUB_CREDENTIALS_ID = "${env.CG_DOCKERHUB_CREDENTIALS_ID ?: 'dockerhub-credentials'}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def propsFileContent = readFile('jenkins/jenkins.properties')
                    def lines = propsFileContent.split('\r?\n')
                    for (line in lines) {
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            def key = parts[0].trim()
                            def val = parts[1].trim()
                            if (key == 'NEWMAN_COLLECTION') {
                                env.NEWMAN_COLLECTION = val
                            } else if (key == 'NEWMAN_ENVIRONMENT') {
                                env.NEWMAN_ENVIRONMENT = val
                            } else if (key == 'LOCUST_PERF_FILE') {
                                env.LOCUST_PERF_FILE = val
                            } else if (key == 'LOCUST_STRESS_FILE') {
                                env.LOCUST_STRESS_FILE = val
                            } else if (key == 'ZAP_SCAN_SCRIPT') {
                                env.ZAP_SCAN_SCRIPT = val
                            }
                        }
                    }
                }
            }
        }
        stage('Pull dev images from DockerHub') {
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service',
                        'circleguard-file-service',
                        'circleguard-dashboard-service'
                    ]
                    for (svc in services) {
                        bat "docker pull ${DOCKER_USER}/${svc}:dev"
                    }
                }
            }
        }
        stage('Deploy to Stage Environment') {
            steps {
                echo 'Ensuring stage namespace exists...'
                bat 'kubectl create namespace stage --dry-run=client -o yaml | kubectl apply -f -'
                echo 'Configuring dynamic Kustomize images...'
                script {
                    def kustomization = readFile('k8s/stage/kustomization.yaml')
                    kustomization = kustomization.replaceAll('newName: srcracles/', "newName: ${env.DOCKER_USER}/")
                    kustomization = kustomization.replaceAll('newTag: stage', 'newTag: dev')
                    writeFile(file: 'k8s/stage/kustomization.yaml', text: kustomization)
                }
                echo 'Applying stage manifests...'
                bat 'kubectl apply -k k8s/stage/'
                echo 'Waiting for services to become ready one by one...'
                script {
                    def services = ['auth', 'identity', 'form', 'gateway', 'notification', 'file', 'promotion', 'dashboard']
                    for (svc in services) {
                        echo "Waiting for circleguard-${svc}-service..."
                        bat "kubectl rollout status deployment/circleguard-${svc}-service -n stage --timeout=300s"
                    }
                }
            }
        }
        // E2E Newman: ACTIVO — genera trafico multi-servicio para validar trazas Jaeger y logs ELK (HU-30/32)
        stage('E2E Tests - Newman') {
            steps {
                echo 'Running Newman E2E tests inside Kubernetes cluster...'
                bat 'kubectl run newman-e2e --restart=Never --image=postman/newman:latest -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/newman-e2e -n stage --timeout=60s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%NEWMAN_COLLECTION%" newman-e2e:/tmp/collection.json -n stage -c newman-e2e'
                bat 'kubectl cp "%NEWMAN_ENVIRONMENT%" newman-e2e:/tmp/environment.json -n stage -c newman-e2e'
                bat 'kubectl exec newman-e2e -n stage -c newman-e2e -- newman run /tmp/collection.json -e /tmp/environment.json --delay-request 500 --reporters cli,junit --reporter-junit-export /tmp/newman-report.xml'
                bat 'kubectl cp newman-e2e:/tmp/newman-report.xml newman-report.xml -n stage -c newman-e2e'
                bat 'kubectl delete pod newman-e2e -n stage --ignore-not-found=true'
            }
            post {
                always {
                    junit testResults: 'newman-report.xml', allowEmptyResults: true
                }
            }
        }
        stage('Security Scan - OWASP ZAP') {
            when { expression { false } }
            steps {
                echo 'Running OWASP ZAP baseline scans against auth, form, and gateway services...'
                bat 'if not exist zap-reports mkdir zap-reports'
                bat 'kubectl delete pod zap-scan -n stage --ignore-not-found=true --force --grace-period=0'
                bat 'kubectl run zap-scan --restart=Never --image=ghcr.io/zaproxy/zaproxy:stable -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/zap-scan -n stage --timeout=120s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl exec zap-scan -n stage -c zap-scan -- mkdir -p /tmp/zap-reports'
                bat 'kubectl cp "%ZAP_SCAN_SCRIPT%" zap-scan:/tmp/run-zap-scans.sh -n stage -c zap-scan'
                bat 'kubectl exec zap-scan -n stage -c zap-scan -- sh /tmp/run-zap-scans.sh'
                bat 'kubectl cp zap-scan:/tmp/zap-reports/. zap-reports/ -n stage -c zap-scan'
                bat 'kubectl delete pod zap-scan -n stage --ignore-not-found=true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap-reports/**/*', allowEmptyArchive: true
                    script {
                        try {
                            publishHTML([
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'zap-reports',
                                reportFiles: 'zap-consolidated-report.html',
                                reportName: 'OWASP ZAP Security Scan',
                                reportTitles: 'CircleGuard ZAP Reports'
                            ])
                        } catch (Exception e) {
                            echo "HTML Publisher plugin not available: ${e.message}"
                        }
                    }
                }
            }
        }
        stage('Evaluate ZAP Results') {
            when { expression { false } }
            steps {
                script {
                    def classifyRisk = { alert ->
                        def code = alert.riskcode?.toString() ?: ''
                        def desc = alert.riskdesc?.toString() ?: ''
                        def alertName = alert.name?.toString() ?: alert.alert?.toString() ?: 'Unknown'
                        if (code == '4' || desc.toUpperCase().startsWith('CRITICAL')) {
                            return [level: 'CRITICAL', name: alertName, desc: desc, pluginid: alert.pluginid]
                        }
                        if (code == '3' || desc.toUpperCase().startsWith('HIGH')) {
                            return [level: 'HIGH', name: alertName, desc: desc, pluginid: alert.pluginid]
                        }
                        if (code == '2' || desc.toUpperCase().startsWith('MEDIUM')) {
                            return [level: 'MEDIUM', name: alertName, desc: desc, pluginid: alert.pluginid]
                        }
                        if (code == '1' || desc.toUpperCase().startsWith('LOW')) {
                            return [level: 'LOW', name: alertName, desc: desc, pluginid: alert.pluginid]
                        }
                        return [level: 'INFO', name: alertName, desc: desc, pluginid: alert.pluginid]
                    }

                    def extractAlerts = { json ->
                        def alerts = []
                        if (json.site instanceof List) {
                            json.site.each { site ->
                                if (site.alerts instanceof List) {
                                    site.alerts.each { a -> alerts << a }
                                }
                            }
                        }
                        return alerts
                    }

                    def reportFiles = [
                        [file: 'zap-reports/zap-auth-report.json', service: 'auth-service'],
                        [file: 'zap-reports/zap-form-report.json', service: 'form-service'],
                        [file: 'zap-reports/zap-gateway-report.json', service: 'gateway-service']
                    ]

                    def criticalAlerts = []
                    def highAlerts = []
                    def mediumAlerts = []
                    def lowAlerts = []
                    def summary = new StringBuilder()
                    summary.append('# OWASP ZAP Security Scan Report (HU-22)\n\n')
                    summary.append('## Policy\n')
                    summary.append('- **CRITICAL / HIGH**: fail the pipeline\n')
                    summary.append('- **MEDIUM / LOW**: documented below, do not block\n\n')

                    reportFiles.each { entry ->
                        if (!fileExists(entry.file)) {
                            echo "WARN: ZAP report not found: ${entry.file}"
                            summary.append("## ${entry.service}\n\n_Report not generated._\n\n")
                            return
                        }

                        def json = readJSON file: entry.file
                        def alerts = extractAlerts(json)
                        def serviceCritical = []
                        def serviceHigh = []
                        def serviceMedium = []
                        def serviceLow = []

                        alerts.each { alert ->
                            def classified = classifyRisk(alert)
                            def item = "${entry.service}: ${classified.name} (${classified.desc})"
                            switch (classified.level) {
                                case 'CRITICAL':
                                    serviceCritical << item
                                    break
                                case 'HIGH':
                                    serviceHigh << item
                                    break
                                case 'MEDIUM':
                                    serviceMedium << item
                                    break
                                case 'LOW':
                                    serviceLow << item
                                    break
                            }
                        }

                        criticalAlerts.addAll(serviceCritical)
                        highAlerts.addAll(serviceHigh)
                        mediumAlerts.addAll(serviceMedium)
                        lowAlerts.addAll(serviceLow)

                        summary.append("## ${entry.service}\n\n")
                        summary.append("| Severity | Count |\n|----------|-------|\n")
                        summary.append("| CRITICAL | ${serviceCritical.size()} |\n")
                        summary.append("| HIGH | ${serviceHigh.size()} |\n")
                        summary.append("| MEDIUM | ${serviceMedium.size()} |\n")
                        summary.append("| LOW | ${serviceLow.size()} |\n\n")

                        if (serviceMedium) {
                            summary.append('### Medium (documented, non-blocking)\n\n')
                            serviceMedium.each { summary.append("- ${it}\n") }
                            summary.append('\n')
                        }
                        if (serviceLow) {
                            summary.append('### Low (documented, non-blocking)\n\n')
                            serviceLow.each { summary.append("- ${it}\n") }
                            summary.append('\n')
                        }
                    }

                    summary.append('## Totals\n\n')
                    summary.append("| Severity | Total |\n|----------|-------|\n")
                    summary.append("| CRITICAL | ${criticalAlerts.size()} |\n")
                    summary.append("| HIGH | ${highAlerts.size()} |\n")
                    summary.append("| MEDIUM | ${mediumAlerts.size()} |\n")
                    summary.append("| LOW | ${lowAlerts.size()} |\n\n")
                    summary.append('## Artifacts\n\n')
                    summary.append('- zap-reports/zap-*-report.html\n')
                    summary.append('- zap-reports/zap-*-report.xml\n')
                    summary.append('- zap-reports/zap-*-report.json\n')
                    summary.append('- zap-reports/zap-consolidated-report.html\n')

                    writeFile file: 'ZAP_SECURITY_REPORT.md', text: summary.toString()
                    archiveArtifacts artifacts: 'ZAP_SECURITY_REPORT.md', allowEmptyArchive: true

                    if (criticalAlerts || highAlerts) {
                        def details = (criticalAlerts + highAlerts).join('\n- ')
                        error("OWASP ZAP found blocking vulnerabilities:\n- ${details}")
                    }

                    echo 'OWASP ZAP scan passed: no HIGH or CRITICAL findings.'
                    if (mediumAlerts || lowAlerts) {
                        echo "Non-blocking findings documented: ${mediumAlerts.size()} MEDIUM, ${lowAlerts.size()} LOW"
                    }
                }
            }
        }
        stage('Performance Test - Locust') {
            when { expression { false } }
            steps {
                echo 'Running Locust performance test inside Kubernetes cluster (with Prometheus exporter)...'
                bat 'kubectl delete -f k8s/stage/locust-metrics.yaml --ignore-not-found=true'
                bat 'kubectl apply -f k8s/stage/locust-metrics.yaml'
                bat 'kubectl wait --for=condition=ready pod/locust-perf -n stage --timeout=120s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%LOCUST_PERF_FILE%" locust-perf:/tmp/locustfile.py -n stage -c locust'
                bat 'kubectl exec locust-perf -n stage -c locust -- locust -f /tmp/locustfile.py --host http://circleguard-auth-service:8180 -u 20 -r 2 --run-time 60s --web-host 0.0.0.0 --web-port 8089 --headless --csv=/tmp/locust-performance'
                bat 'ping 127.0.0.1 -n 31 > nul'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_stats.csv locust-performance_stats.csv -n stage -c locust || echo "No perf stats"'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_failures.csv locust-performance_failures.csv -n stage -c locust || echo "No perf failures"'
                bat 'kubectl cp locust-perf:/tmp/locust-performance_exceptions.csv locust-performance_exceptions.csv -n stage -c locust || echo "No perf exceptions"'
                bat 'kubectl delete -f k8s/stage/locust-metrics.yaml --ignore-not-found=true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-performance_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Stress Test - Locust') {
            when { expression { false } }
            steps {
                echo 'Running Locust stress test inside Kubernetes cluster...'
                bat 'kubectl run locust-stress --restart=Never --image=locustio/locust:2.29.0 -n stage --command -- sleep 3600'
                bat 'kubectl wait --for=condition=ready pod/locust-stress -n stage --timeout=60s'
                bat 'ping 127.0.0.1 -n 6 > nul'
                bat 'kubectl cp "%LOCUST_STRESS_FILE%" locust-stress:/tmp/locustfile.py -n stage -c locust-stress'
                bat 'kubectl exec locust-stress -n stage -c locust-stress -- locust -f /tmp/locustfile.py --host http://circleguard-auth-service:8180 -u 50 -r 3 --run-time 60s --headless --csv=/tmp/locust-stress'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_stats.csv locust-stress_stats.csv -n stage -c locust-stress || echo "No stress stats"'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_failures.csv locust-stress_failures.csv -n stage -c locust-stress || echo "No stress failures"'
                bat 'kubectl cp locust-stress:/tmp/locust-stress_exceptions.csv locust-stress_exceptions.csv -n stage -c locust-stress || echo "No stress exceptions"'
                bat 'kubectl delete pod locust-stress -n stage --ignore-not-found=true'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-stress_*.csv', allowEmptyArchive: true
                }
            }
        }
        stage('Generate Performance Report') {
            when { expression { false } }
            steps {
                script {
                    def perfStats = ""
                    def stressStats = ""
                    
                    if (fileExists('locust-performance_stats.csv')) {
                        perfStats = readFile('locust-performance_stats.csv')
                    }
                    if (fileExists('locust-stress_stats.csv')) {
                        stressStats = readFile('locust-stress_stats.csv')
                    }
                    
                    writeFile file: 'PERFORMANCE_REPORT.md', text: """# Performance Test Report

## Performance Test (Normal Load)
- Users: 20
- Ramp-up: 2 users/sec
- Duration: 60 seconds

```csv
${perfStats}
```

## Stress Test (High Load)
- Users: 50
- Ramp-up: 3 users/sec
- Duration: 60 seconds

```csv
${stressStats}
```

## Artifacts
- locust-performance_stats.csv
- locust-performance_failures.csv
- locust-performance_exceptions.csv
- locust-stress_stats.csv
- locust-stress_failures.csv
- locust-stress_exceptions.csv
"""
                }
                archiveArtifacts artifacts: 'PERFORMANCE_REPORT.md', allowEmptyArchive: true
            }
        }
        stage('Promote dev to stage tag') {
            when { expression { false } }
            steps {
                script {
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service',
                        'circleguard-file-service',
                        'circleguard-dashboard-service'
                    ]
                    for (svc in services) {
                        bat "docker tag ${DOCKER_USER}/${svc}:dev ${DOCKER_USER}/${svc}:stage"
                        withDockerRegistry([credentialsId: env.DOCKERHUB_CREDENTIALS_ID, url: '']) {
                            bat "docker push ${DOCKER_USER}/${svc}:stage"
                        }
                    }
                }
            }
        }
    }
    post {
        failure {
            echo 'Stage pipeline failed. Resources left running for debugging.'
            echo 'Run manually to clean up: kubectl delete deployment,service,configmap,secret --all -n stage'
        }
        success {
            // TEMP (HU-30/32 ELK): mantener stage desplegado para validar logs en Kibana y trazas en Jaeger
            echo 'Stage pipeline succeeded. Stage namespace left running for ELK/Jaeger validation.'
            echo 'Manual cleanup when done: kubectl delete deployment,service,configmap,secret --all -n stage'
            script {
                if (false) {
                    echo 'Stage pipeline succeeded. Cleaning up stage resources and local images...'
                    bat 'kubectl delete deployment --all -n stage --ignore-not-found=true'
                    bat 'kubectl delete service --all -n stage --ignore-not-found=true'
                    bat 'kubectl delete configmap --all -n stage --ignore-not-found=true'
                    bat 'kubectl delete secret --all -n stage --ignore-not-found=true'
                    bat 'kubectl delete pod --all -n stage --force --grace-period=0 --ignore-not-found=true'
                    def services = [
                        'circleguard-auth-service',
                        'circleguard-identity-service',
                        'circleguard-form-service',
                        'circleguard-promotion-service',
                        'circleguard-notification-service',
                        'circleguard-gateway-service',
                        'circleguard-file-service',
                        'circleguard-dashboard-service'
                    ]
                    for (svc in services) {
                        bat "docker rmi ${DOCKER_USER}/${svc}:dev 2>nul || exit 0"
                        bat "docker rmi ${DOCKER_USER}/${svc}:stage 2>nul || exit 0"
                    }
                }
            }
        }
    }
}
